{
  "name": "goose-discord-bot",
  "private": true,
  "version": "0.0.1",
  "author": "80PercentLean",
  "type": "module",
  "scripts": {
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "build-template": "ejs ./src/index.ejs -f package.json -o ./public/index.html",
    "deploy": "wrangler deploy --minify",
    "dev": "wrangler dev",
    "format": "npm run format:check",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "predeploy": "npm run build-template",
    "predev": "npm run build-template",
    "rad": "npm run register && npm run deploy",
    "register": "tsc && node --env-file=.env dist/register.js"
  },
  "dependencies": {
    "discord-api-types": "^0.38.47",
    "discord-hono": "^0.21.2",
    "hono": "^4.12.18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^25.6.2",
    "ejs": "^5.0.2",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "wrangler": "^4.90.0"
  }
}
